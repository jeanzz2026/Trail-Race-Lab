{
  "manifest_version": 3,
  "name": "Trail Race Lab - ITRA Capture",
  "version": "0.1.2",
  "description": "Read a verified ITRA results page and send the result table to Trail Race Lab.",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": [
    "https://itra.run/Races/RaceResults/*",
    "https://trail-race-lab.streamlit.app/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Capture ITRA results",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://itra.run/Races/RaceResults/*",
        "https://trail-race-lab.streamlit.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
